# Puerto publicado por Docker Compose.
APP_PORT=3000

# URL privada que las rutas API de Next.js usan para comunicarse con el backend.
BACKEND_URL=https://backend-app-movil-177686674468.europe-west1.run.app

# Las variables NEXT_PUBLIC_* se incorporan durante la construccion de la imagen.
NEXT_PUBLIC_APP_NAME=FABRYOR Admin

# Activa trazas de autenticacion solo para diagnostico temporal.
AUTH_DEBUG=false
